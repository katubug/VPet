
// Position and spacing
margin = 20;
bar_spacing = 10; // Space between bars

// Bar dimensions
bar_width = 200;
bar_height = 20;
bar_outline = 2; // Border thickness

// Colors
color_bg = c_black;
color_border = c_white;
color_hunger_full = c_lime;
color_hunger_empty = c_dkgray;
color_happiness_full = c_yellow;
color_happiness_empty = c_dkgray;

// Alpha
bar_bg_alpha = 0.6;
bar_fill_alpha = 1.0;

// Extended stats toggle
show_extended_stats = false; // Toggle with Shift+S
