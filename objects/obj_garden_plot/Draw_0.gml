draw_self();

if(plot_seed_type == "obj_seed_joy")
{
	draw_ellipse_colour(plot_x-10, plot_y-10, plot_x+20, plot_y+20, c_yellow & c_yellow, c_yellow & c_yellow, 0);
}

if(plot_seed_type == "obj_seed_enthusiasm")
{
	draw_ellipse_colour(plot_x-10, plot_y-10, plot_x+20, plot_y+20, c_aqua & c_aqua, c_aqua & c_aqua, 0);
}

if(plot_seed_type == "obj_seed_nonsense")
{
	draw_ellipse_colour(plot_x-10, plot_y-10, plot_x+20, plot_y+20, c_lime & c_lime, c_lime & c_lime, 0);
}

if(plot_seed_type == "obj_seed_selfesteem")
{
	draw_ellipse_colour(plot_x-10, plot_y-10, plot_x+20, plot_y+20, c_fuchsia & c_fuchsia, c_fuchsia & c_fuchsia, 0);
}